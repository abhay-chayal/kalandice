# Copy this file to .env.local for local development, and add the same values
# in Vercel → Project → Settings → Environment Variables for production.

# The public address of the site (no trailing slash). Used for SEO, the sitemap,
# and links inside password-reset emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET — server only. Never commit it or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com) — emails Kalandice when someone uses a form.
# Optional: without it, submissions are still saved and visible in /admin/messages.
RESEND_API_KEY=
# Until a domain is verified in Resend, keep onboarding@resend.dev (it can only
# deliver to the email address that owns the Resend account).
EMAIL_FROM=Encouraging Poetics <onboarding@resend.dev>
NOTIFY_EMAIL=kalandice.poetics@gmail.com

# Any long random string. Vercel sends it with the daily keep-alive cron call.
CRON_SECRET=
